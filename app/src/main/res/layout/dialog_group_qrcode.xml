<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_input_box"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvDialogGroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="群聊名称"
        android:textColor="#1A1D24"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 显示最终合成的二维码 -->
    <ImageView
        android:id="@+id/ivDialogQrCode"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:scaleType="fitCenter" />

    <!-- ✨ 新增：保存到相册按钮 -->
    <TextView
        android:id="@+id/tvSaveQrCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="保存二维码到相册"
        android:textColor="#1A65FF"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E4E7ED" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="让朋友扫描以上的群二维码名片，即可快速加入本群聊。"
        android:textColor="#5E6573"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3" />

    <Button
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_capsule_button"
        android:text="我知道了"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        style="?android:attr/borderlessButtonStyle"/>

</LinearLayout>