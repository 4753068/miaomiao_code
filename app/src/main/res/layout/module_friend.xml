<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp">

    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/thumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            app:riv_corner_radius="48dp"
            app:riv_mutate_background="true" />

        <ImageView
            android:id="@+id/jinzhilianxi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|top"
            android:src="@drawable/jujue"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivGroupBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:src="@drawable/group"
            android:padding="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message_number"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_capsule_new"
            android:gravity="center"
            android:layout_gravity="top|right"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="99+" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/avatarContainer"
        app:layout_constraintEnd_toStartOf="@id/newBox"
        app:layout_constraintStart_toEndOf="@id/avatarContainer"
        app:layout_constraintTop_toTopOf="@id/avatarContainer">

        <Emoji.ApngTextView
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Alicia Davis" />

        <Emoji.ApngTextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/gay"
            tools:text="请求添加你为好友" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/newBox"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/avatarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/avatarContainer">

        <TextView
            android:id="@+id/updatetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gay"
            android:textSize="14sp"
            android:layout_marginRight="10dp"
            android:layout_gravity="right"
            android:gravity="right"
            tools:text="12:00" />

        <LinearLayout
            android:id="@+id/TongyiBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnJujue"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:layout_margin="5dp"
                android:text="拒绝"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_capsule_button_black"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/btnTongyi"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_margin="5dp"
                android:text="同意"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_capsule_button"
                android:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/list_divider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="12dp"
        android:background="@drawable/border_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>