<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/app_icon_img_box"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/app_icon_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/app_icon_img_box"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="#555555" />

    <View
        android:id="@+id/app_badge_check"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_alignTop="@id/app_icon_img_box"
        android:layout_alignRight="@id/app_icon_img_box"
        android:layout_marginTop="-4dp"
        android:layout_marginRight="-4dp"
        android:background="@drawable/bg_circle_blue_check_badge"
        android:visibility="gone" />

</RelativeLayout>