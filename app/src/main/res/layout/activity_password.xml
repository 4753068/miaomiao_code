<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="安全密码"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"/>

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:elevation="2dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_secure"
                android:contentDescription="icon" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="设置安全密码"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="请输入 6 位数字以安全访问隐私控制台"
            android:textColor="#999999"
            android:textSize="14sp"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/llFormGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp">
        </LinearLayout>

        <TextView
            android:id="@+id/tvHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#999999"
            android:visibility="invisible"/>

        <LinearLayout
            android:id="@+id/llActionArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp">

            <Button
                android:id="@+id/btnPrimary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="确定并继续"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_capsule_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>