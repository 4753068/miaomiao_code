<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <!-- 左侧接收消息整体容器 -->
        <LinearLayout
            android:id="@+id/Show_Chat_Left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="50dp"
            android:orientation="horizontal"
            android:padding="5dp"
            tools:ignore="MissingConstraints">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/left_thumb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:layout_marginRight="10dp"
                android:scaleType="centerCrop"
                android:visibility="visible"
                app:riv_oval="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 昵称和时间行 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:layout_marginLeft="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtSenderNickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        tools:text="好友昵称" />

                    <TextView
                        android:id="@+id/txtTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:textColor="#999999"
                        android:textSize="11sp"
                        tools:text="上午07:33" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 聊天气泡 -->
                        <LinearLayout
                            android:id="@+id/leftBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chat_box_white"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Emoji.ApngTextView
                                    android:id="@+id/txtMessage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="260dp"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <Emoji.ApngTextView
                                android:id="@+id/txtYingyongLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:autoLink="web"
                                android:ellipsize="end"
                                android:maxWidth="260dp"
                                android:singleLine="true"
                                android:textColor="#999999"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- 左侧地图位置卡片 -->
                        <LinearLayout
                            android:id="@+id/leftLocationBox"
                            android:layout_width="230dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_box"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvLeftLocTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="位置信息"
                                android:textColor="#111111"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLeftLocAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="详细地址信息"
                                android:textColor="#888888"
                                android:textSize="12sp" />

                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/ivLeftLocMap"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:layout_marginTop="6dp"
                                android:background="#EFEFEF"
                                android:scaleType="centerCrop"
                                app:riv_corner_radius="8dp" />
                        </LinearLayout>

                        <!-- 多媒体消息容器 -->
                        <LinearLayout
                            android:id="@+id/leftMediaBox"
                            android:layout_width="230dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_box"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="130dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp">
                                    <ImageView
                                        android:id="@+id/left_file_icon"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop" />
                                </androidx.cardview.widget.CardView>
                                <TextView
                                    android:id="@+id/leftMediaContent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="20dp"
                                    android:fontFamily="@font/futura"
                                    android:gravity="top|right"
                                    android:textColor="@color/white"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />
                                <ImageView
                                    android:id="@+id/btnLeftPauseConfirm"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/yanjing" />
                                <ProgressBar
                                    android:id="@+id/ProgressBarLeft"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="bottom|right"
                                    android:layout_margin="10dp"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progressDrawable="@drawable/custom_progress_bar"
                                    android:visibility="gone" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="10dp"
                                android:gravity="center"
                                android:text="查看之前请注意保护个人隐私"
                                android:textColor="#999999"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTimeCountLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧发送消息整体容器 -->
        <LinearLayout
            android:id="@+id/Show_Chat_Right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginBottom="10dp"
            android:gravity="right"
            android:orientation="horizontal"
            android:padding="5dp"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSenderNicknameRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="4dp"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:layout_marginLeft="10dp"
                        android:gravity="right"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="right">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/RightError"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_margin="10dp"
                                    android:src="@drawable/error"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/rightBox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/chat_box_blue"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <Emoji.ApngTextView
                                            android:id="@+id/txtMessageRight"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxWidth="260dp"
                                            android:textColor="#ffffff"
                                            android:textSize="16sp" />
                                    </LinearLayout>

                                    <Emoji.ApngTextView
                                        android:id="@+id/txtYingyongRight"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:autoLink="web"
                                        android:ellipsize="end"
                                        android:maxWidth="260dp"
                                        android:singleLine="true"
                                        android:textColor="#e8e8e8"
                                        android:textSize="14sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>

                        <!-- 右侧地图位置卡片 -->
                        <LinearLayout
                            android:id="@+id/rightLocationBox"
                            android:layout_width="230dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_box"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvRightLocTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="位置信息"
                                android:textColor="#111111"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRightLocAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="详细地址信息"
                                android:textColor="#888888"
                                android:textSize="12sp" />

                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/ivRightLocMap"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:layout_marginTop="6dp"
                                android:background="#EFEFEF"
                                android:scaleType="centerCrop"
                                app:riv_corner_radius="8dp" />
                        </LinearLayout>

                        <!-- 多媒体消息容器 -->
                        <LinearLayout
                            android:id="@+id/rightMediaBox"
                            android:layout_width="230dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_box"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="130dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:id="@+id/right_file_icon"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop" />
                                </androidx.cardview.widget.CardView>

                                <TextView
                                    android:id="@+id/rightMediaContent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="20dp"
                                    android:fontFamily="@font/futura"
                                    android:gravity="top|right"
                                    android:textColor="@color/white"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/btnRightPauseConfirm"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/yanjing" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="10dp"
                                android:gravity="center"
                                android:text="查看之前请注意保护个人隐私"
                                android:textColor="#999999"
                                android:textSize="14sp" />

                            <ProgressBar
                                android:id="@+id/ProgressBarRight"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_margin="5dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progressDrawable="@drawable/custom_progress_bar"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- 时间与已读图标组合 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/RightYidu"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginRight="4dp"
                                android:src="@drawable/yidu"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtTimeRight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12:00"
                                android:textColor="#999"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginTop="2dp"
                            android:layout_marginRight="5dp"
                            android:gravity="right"
                            android:text="信息已发送，对方未查收"
                            android:textColor="#FF4D4F"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTimeCountRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/right_thumb"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center|top"
                android:layout_marginLeft="10dp"
                android:visibility="gone"
                app:riv_corner_radius="5dp"
                app:riv_mutate_background="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>