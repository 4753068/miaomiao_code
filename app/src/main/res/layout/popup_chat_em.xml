<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#F7F8FA"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardMaxElevation="4dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <!-- 高度改为 match_parent，让内部组件可以按比例分配 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- 第一个表情列表：最近使用的表情 (取消隐藏，设为可见) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/em_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="45dp"
            android:overScrollMode="never"
            android:visibility="visible" />

        <!-- 两层表情之间的细线分割 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="#EAEAEA" />

        <!-- ✨核心修复：第二个表情列表 (主表情库) -->
        <!-- layout_height="0dp" 加上 layout_weight="1" 会让它吃掉所有剩余的空白高度，彻底消灭下方白框 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/embox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- 底部功能区与表情区的分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#E5E6EB" />

        <!-- 底部轻量功能栏：下部放三个按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 相册 -->
            <LinearLayout
                android:id="@+id/upload_zhaopian"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/mphoto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="相册"
                    android:textColor="#4E5969"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 拍照 -->
            <LinearLayout
                android:id="@+id/upload_paizhao"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/mpaizhao" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="拍照"
                    android:textColor="#4E5969"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 录像 -->
            <LinearLayout
                android:id="@+id/upload_luxiang"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/mluxiang" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="录像"
                    android:textColor="#4E5969"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 位置（备用，平时隐藏） -->
            <LinearLayout
                android:id="@+id/upload_weizhi"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/mweizhi" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="位置"
                    android:textColor="#4E5969"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>