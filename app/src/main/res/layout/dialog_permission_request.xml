<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_input_box"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="重要提醒"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPermissionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="为了保证您能及时收到好友发送的信息，请勾选以下两项，并按系统提示完成设置。"
        android:textColor="#5E6573"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.2"/>

    <CheckBox
        android:id="@+id/cbNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="打开应用通知 (接收新消息)"
        android:textColor="#333333"
        android:buttonTint="#4CAF50"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvNotificationDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="必须打开才能正常接收信息，打开后通知栏会出现一条常驻通知，您可以点击通知权限，然后将”喵喵常驻通知“关闭。"
        android:textColor="#999999"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2"/>

    <CheckBox
        android:id="@+id/cbBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="加入后台白名单 (防系统杀后台)"
        android:textColor="#333333"
        android:buttonTint="#4CAF50"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvBatteryDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="为了保证及时收到信息，请将喵喵加入系统白名单，如果是弹出对话框，请点击”允许“，如果是弹出选择页面，请选择”无限制“。"
        android:textColor="#999999"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2"/>

    <CheckBox
        android:id="@+id/cbNeverShowAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="下次不再显示"
        android:textColor="#999999"
        android:buttonTint="#999999"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPermissionConfirm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_capsule_button"
            android:text="知道了"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>

</LinearLayout>