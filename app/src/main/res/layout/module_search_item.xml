<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/ivAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:src="@drawable/user_default"
        app:riv_corner_radius="8dp" />

    <!-- 昵称与性别图标横向排列 -->
    <LinearLayout
        android:id="@+id/layoutName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/ivAvatar"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@+id/btnAction"
        android:layout_toEndOf="@id/ivAvatar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="喵友"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 🌟 性别图标 -->
        <ImageView
            android:id="@+id/ivSex"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <!-- 群标识 -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#EAF2FF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="群"
            android:textColor="#1A65FF"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutName"
        android:layout_alignStart="@id/layoutName"
        android:layout_marginTop="4dp"
        android:layout_toStartOf="@+id/btnAction"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="距离您 500m"
        android:textColor="#888888"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnAction"
        android:layout_width="64dp"
        android:layout_height="30dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_capsule_button"
        android:gravity="center"
        android:text="添加"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</RelativeLayout>